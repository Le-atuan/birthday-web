{
  "name": "birthday",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,scss -c blue,magenta \"next dev -p 4000\" \"pnpm run css:watch\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "css:build": "sass src/styles/birthday-card/index.scss public/birthday-card/style.css --no-source-map --no-charset --style=expanded",
    "css:watch": "sass --watch src/styles/birthday-card/index.scss:public/birthday-card/style.css --no-source-map --no-charset --style=expanded",
    "predev": "pnpm run css:build",
    "prebuild": "pnpm run css:build"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "lottie-react": "^3.0.0",
    "luxon": "^3.7.2",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.2",
    "resend": "^6.20.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.10.0"
}
